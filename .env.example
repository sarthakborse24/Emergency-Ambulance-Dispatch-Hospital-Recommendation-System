# ==============================================================================
# MedRoute — Environment Configuration Template
# Copy this file to .env and customize values as needed.
# ==============================================================================

# Database Connection (Default: local SQLite database)
DATABASE_URL=sqlite:///emergency_dispatch.db
# For MySQL: mysql+pymysql://username:password@localhost:3306/emergency_dispatch

# Flask Server Port
PORT=5000
SECRET_KEY=medroute-emergency-dispatch-secret-key-2026

# Recommendation Scoring Weights (must sum to 1.0)
WEIGHT_DISTANCE=0.40
WEIGHT_TRAFFIC=0.30
WEIGHT_BEDS=0.20
WEIGHT_SPECIALIZATION=0.10

# Default Ambulance Travel Speed (km/h)
DEFAULT_AMBULANCE_SPEED_KMH=45.0
